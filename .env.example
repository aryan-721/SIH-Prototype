# Database URL (SQLite for local demo, PostgreSQL + pgvector for production)
DATABASE_URL=sqlite:///./skill_intelligence.db

# Anthropic Claude API Key (Optional: Demo Mode fallback activates if left empty)
ANTHROPIC_API_KEY=

# Demo Mode Toggle (true / false)
DEMO_MODE=true

# Mock iGOT API Base URL
MOCK_IGOT_BASE_URL=http://localhost:8000/mock-igot

# Next.js Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Keycloak Configuration (Production Target)
KEYCLOAK_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
